# ---------------------------------------------------------------------------
# Model weights -- NEVER commit these. A single checkpoint is ~327MB, which is
# over GitHub's 100MB hard limit per file, and once a large blob is in history
# it stays there even after deletion. Checkpoints are reproducible by running
# train.py; results live in MLflow and in the README.
# ---------------------------------------------------------------------------
checkpoints/
*.pth
*.pt
*.ckpt
*.safetensors

# Downloaded run artifacts and local archives of previous runs
run*_archive/
*_archive/

# ---------------------------------------------------------------------------
# Experiment tracking -- regenerated on every run
# ---------------------------------------------------------------------------
mlflow.db
mlartifacts/
mlruns/
train.log
*.log
*.err

# ---------------------------------------------------------------------------
# Datasets and generated data -- large and reproducible.
#   data/images, data/masks   <- generate_anomalies.py (needs a CARLA server)
#   data/coco_objects         <- download_coco_anomalies.py
#   Cityscapes / Fishyscapes  <- external downloads, see config.py paths
# ---------------------------------------------------------------------------
data/images/
data/masks/
data/coco_objects/
data/_coco_download/
data/_excluded_objects/

# ---------------------------------------------------------------------------
# Generated outputs
# ---------------------------------------------------------------------------
check_*.png
calibration_reliability.png

# Demo: panels are regenerated by server.py from the checkpoint; the React
# build and its dependencies are reproducible from frontend/package*.json
# (static/generated/explain/ is written by `python explain.py --demo`)
static/generated/
# explain.py outputs (summary.json + per-object CSV); the numbers live in runs/RESULTS.md
runs/explain/
static_react/
frontend/node_modules/
*.zip

# Planning/report HTML -- generated docs, not project source
*.html
# ...except the React app's entry page, which IS source: without it the
# frontend cannot be built.
!frontend/index.html

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
